/* color scheme classes are applied to every element so inheritance issues are avoided background color overrides may be needed for scenarios where a background color class and colorscheme are applied together */

.colormode-light {
	
	&.section-standard {
		color: theme('colors.black');
		background-color: theme('colors.white');
	}
	
	/* accordions */
	&.accordion {
		background-color: theme('colors.gray.300');
		color: theme('colors.black');
		
		/* adjust these styles if you want the button to be a different color, etc. */
		& > .accordion-header > .accordion-button {
			
			&:hover {
				background-color: theme('colors.gray.400');
				color: theme('colors.black');
			}
		}
	}
	
	/* tab sets */
	&.tab-panel {
		background-color: theme('colors.gray.300');
		color: theme('colors.black');
	}
	
	&.tab-set-btn {
		background-color: theme('colors.gray.500');
		color: theme('colors.white');
		
		&:hover {
			background-color: theme('colors.gray.700');
			color: theme('colors.white');
		}
		
		&[aria-selected=true] {
			background-color: theme('colors.gray.300');
			color: theme('colors.black');
		}
	}
	
	/* Buttons */
	
	&.btn-standard {
		background-color: theme('colors.gray.500');
		color: theme('colors.white');
		
		&:hover {
			background-color: theme('colors.gray.700');
			color: theme('colors.white');
		}
	}
	
	&.btn-text {
		color: theme('colors.gray.700');
		
		&:hover {
			color: theme('colors.gray.500');
		}
	}
	
	&.btn-text-arrow {
		color: theme('colors.gray.700');
		
		&:hover {
			color: theme('colors.gray.500');
		}
	}
	
	/* Media */
	
	&.content-image, &.content-video {
		background-color: theme('colors.gray.300');
		color: theme('colors.black');
	}
	
	
	/* TEXT COLOR OVERRIDES */
	/* Make a style rule for every color available in the text color picker in the CP. These need to be at the end of a color scheme definition */
	
	&.text-white {
		color: theme('colors.white');
	}
	
	&.text-black {
		color: theme('colors.black');
	}
	
	&.text-red {
		color: theme('colors.red');
	}	
	
	/* BACKGROUND COLOR OVERRIDES */
	/* Make a style rule for every color available in the bg color picker in the CP. These need to be at the end of a color scheme definition */
	
	&.bg-transparent {
		background-color: transparent;
	}
	
	&.bg-white {
		background-color: theme('colors.white');
	}
	
	&.bg-black {
		background-color: theme('colors.black');
	}
	
	&.bg-red {
		background-color: theme('colors.red');
	}
	
}

.colormode-dark {
	
	&.section-standard {
		color: theme('colors.white');
		background-color: theme('colors.black');
	}
	
	/* accordions */
	&.accordion {
		background-color: theme('colors.gray.700');
		color: theme('colors.white');
		
		/* adjust these styles if you want the button to be a different color, etc. */
		& > .accordion-header > .accordion-button {
			
			&:hover {
				background-color: theme('colors.gray.600');
				color: theme('colors.white');
			}
		}
	}
	
	/* tab sets */
	&.tab-panel {
		background-color: theme('colors.gray.700');
		color: theme('colors.white');
	}
	
	&.tab-set-btn {
		background-color: theme('colors.gray.300');
		color: theme('colors.black');
		
		&:hover {
			background-color: theme('colors.gray.400');
		}
		
		&[aria-selected=true] {
			background-color: theme('colors.gray.700');
			color: theme('colors.white');
		}
	}
	
	/* Buttons */
	
	&.btn-standard {
		background-color: theme('colors.gray.700');
		color: theme('colors.white');
		
		&:hover {
			background-color: theme('colors.gray.400');
			color: theme('colors.white');
		}
	}
	
	&.btn-text {
		color: theme('colors.gray.400');
		
		&:hover {
			color: theme('colors.white');
		}
	}
	
	&.btn-text-arrow {
		color: theme('colors.gray.400');
		
		&:hover {
			color: theme('colors.white');
		}
	}
	
	/* Media */
	
	&.content-image, &.content-video {
		background-color: theme('colors.gray.700');
		color: theme('colors.white');
	}
	
}

.colormode-red {
	
	&.section-standard {
		color: theme('colors.white');
		background-color: theme('colors.black');
	}
	
	/* accordions */
	&.accordion {
		background-color: theme('colors.red');
		color: theme('colors.white');
		
		/* adjust these styles if you want the button to be a different color, etc. */
		& > .accordion-header > .accordion-button {
			
			&:hover {
				background-color: lighten(theme('colors.red'), 20%);
				color: theme('colors.white');
			}
		}
	}
	
	/* tab sets */
	&.tab-panel {
		background-color: theme('colors.red');
		color: theme('colors.white');
	}
	
	&.tab-set-btn {
		background-color: theme('colors.gray.300');
		color: theme('colors.black');
		
		&:hover {
			background-color: theme('colors.gray.400');
		}
		
		&[aria-selected=true] {
			background-color: theme('colors.red');
			color: theme('colors.white');
		}
	}
	
	/* Buttons */
	
	&.btn-standard {
		background-color: theme('colors.red');
		color: theme('colors.white');
		
		&:hover {
			background-color: lighten(theme('colors.red'), 20%);
			color: theme('colors.white');
		}
	}
	
	&.btn-text {
		color: theme('colors.red');
		
		&:hover {
			color: lighten(theme('colors.red'), 20%);
		}
	}
	
	&.btn-text-arrow {
		color: theme('colors.red');
		
		&:hover {
			color: lighten(theme('colors.red'), 20%);
		}
	}
	
	/* Media */
	
	&.content-image, &.content-video {
		background-color: theme('colors.gray.700');
		color: theme('colors.white');
	}
	
}


/* Button Colors */

.btn-standard.btn-red {
	background-color: theme('colors.red');
	color: theme('colors.white');
	
	&:hover {
		background-color: lighten(theme('colors.red'), 20%);
		color: theme('colors.white');
	}
}







