/**
*
* Slider Set component specific styles
*
*/

.slider-set, .repeater-slider {
	/* These classes must stay in order to ensure functionality */
	position: relative;
	overflow: hidden;
	/* The default classes and style below can be changed on a per-project basis */
	margin-top: theme('spacing.normal');
	  
	&:first-child {
		margin-top: 0;
	}
}

.slide {
	overflow: hidden;
	position: relative;
	width: 100%;
	display: block;
}

.slide-layout {
	position: relative;
	width: 100%;
	display: block;
	z-index: 10;
}

.slide-link {
	position: relative;
	width: 100%;
	display: block;
	cursor: pointer;
}

.slide-content {
	text-align: left;
	padding-left: theme('spacing.normal');
	padding-right: theme('spacing.normal');
	position: relative;		
}

.slide-image {
	width: 100%;
	position: relative;
	
	picture {
		padding: 0;
		display: block;
	}
}